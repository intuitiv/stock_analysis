# Application settings
PROJECT_NAME="Stock Analysis API"
VERSION="0.1.0"
APP_NAME=Naetra
DEBUG=false
APP_SECRET_KEY=your-secret-key-here
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Database settings
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/naetra
DATABASE_ECHO=false
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_ECHO_LOG=false

# Testing
TEST_DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/naetra_test
TEST_SECRET_KEY=test-secret-key-for-testing-only-not-for-production

# CORS settings
CORS_ORIGINS=["http://localhost:3000"]
CORS_ALLOW_CREDENTIALS=true

# Redis settings
REDIS_URL=redis://localhost:6379/0
REDIS_POOL_SIZE=5

# External APIs (optional)
ALPHA_VANTAGE_API_KEY=your-alpha-vantage-key-here
FINNHUB_API_KEY=your-finnhub-key-here
YAHOO_FINANCE_API_KEY=your-yahoo-finance-key-here
SEC_EDGAR_USER_AGENT=your-email@example.com
